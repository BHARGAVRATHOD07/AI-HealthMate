PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key
PASSWORD_RESET_OTP_SECRET=generate_a_unique_32_byte_random_secret

# Preferred transactional email provider (Works on Render, Vercel, and Cloud)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=AI HealthMate <onboarding@resend.dev>

# Alternative: SMTP configuration for password reset email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=AI HealthMate <your_gmail@gmail.com>

